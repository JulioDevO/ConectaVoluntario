          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.token) { pm.collectionVariables.set('tokenOng', dados.token); pm.collectionVariables.set('ongId', dados.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login voluntário",
