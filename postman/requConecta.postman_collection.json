            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeFantasia\": \"ONG Esperança\",\n  \"razaoSocial\": \"Associação Esperança\",\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"email\": \"ong.teste@exemplo.com\",\n  \"senha\": \"123456\",\n  \"cidade\": \"Campina Grande\",\n  \"descricao\": \"Apoio a comunidades.\"\n}",
