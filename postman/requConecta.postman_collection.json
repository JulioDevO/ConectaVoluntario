            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria da Silva\",\n  \"email\": \"maria.teste@exemplo.com\",\n  \"senha\": \"123456\",\n  \"telefone\": \"(83) 99999-9999\",\n  \"causas\": [\n    \"Educação\",\n    \"Meio Ambiente\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login ONG",
          "request": {
            "method": "POST",
            "header": [
